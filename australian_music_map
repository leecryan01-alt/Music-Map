function sel(i){
  if(active!==null){document.getElementById('p'+active)?.classList.remove('active');document.getElementById('r'+active)?.classList.remove('active');}
  active=i;
  document.getElementById('p'+i)?.classList.add('active');document.getElementById('r'+i)?.classList.add('active');
  const pin=PINS[i];
  document.getElementById('pn').textContent=pin.location;
  document.getElementById('ploc').textContent=pin.artist;
  document.getElementById('pgen').textContent=pin.genre;
  document.getElementById('pnote').textContent=pin.note;
  const vid=VIDEOS[pin.artist];
  const btn=document.getElementById('vid-btn');
  if(vid){
    document.getElementById('vid-thumb').src='https://img.youtube.com/vi/'+vid.id+'/hqdefault.jpg';
    document.getElementById('vid-thumb').alt=vid.song+' — '+pin.artist;
    btn.href='https://www.youtube.com/watch?v='+vid.id;
    btn.style.display='block';
    document.getElementById('vid-label').innerHTML='<strong>Click to watch on YouTube:</strong> '+vid.song;
  } else {
    btn.style.display='none';
    document.getElementById('vid-label').textContent='';
  }
  document.getElementById('panel').classList.add('on');
  document.getElementById('r'+i)?.scrollIntoView({behavior:'smooth',block:'nearest'});
}

function closePanel(){
  document.getElementById('panel').classList.remove('on');
  if(active!==null){document.getElementById('p'+active)?.classList.remove('active');document.getElementById('r'+active)?.classList.remove('active');active=null;}
