const connG=document.getElementById('connectors');
const pinG=document.getElementById('pins');
let active=null;

PINS.forEach((pin,i)=>{
  const dx=pin.x-pin.tx,dy=pin.y-pin.ty;
  if(Math.sqrt(dx*dx+dy*dy)>8){
    const dot=document.createElementNS(NS,'circle');
    dot.setAttribute('cx',pin.tx);dot.setAttribute('cy',pin.ty);dot.setAttribute('r','3');dot.setAttribute('class','dot');
    connG.appendChild(dot);
    const line=document.createElementNS(NS,'line');
    line.setAttribute('x1',pin.tx);line.setAttribute('y1',pin.ty);line.setAttribute('x2',pin.x);line.setAttribute('y2',pin.y);line.setAttribute('class','connector');
    connG.appendChild(line);
