<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Australian Music — Where Are They From?</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --gd:#1a5c38;--gm:#2d7a50;--gl:#e8f5ee;--gp:#f2faf5;
  --oc:#b8d4e8;--la:#cce8b8;--ls:#5a9e6f;
  --td:#1a2e24;--tm:#3d5a48;--tl:#6b8c7a;--ac:#c8780e;
}
body{font-family:'DM Sans',sans-serif;background:#f5f0e8;color:var(--td);height:100vh;overflow:hidden;display:flex;flex-direction:column}
header{background:var(--gd);color:white;padding:14px 28px;display:flex;align-items:center;border-bottom:4px solid var(--ac);flex-shrink:0}
header h1{font-family:'Playfair Display',serif;font-size:1.6rem;font-weight:900;line-height:1}
header span{font-size:0.82rem;color:rgba(255,255,255,0.5);margin-left:auto}
.layout{display:grid;grid-template-columns:1fr 340px;flex:1;overflow:hidden;min-height:0}
.map-wrap{position:relative;background:var(--oc);overflow:hidden}
#svg{width:100%;height:100%;display:block}
.land{fill:var(--la);stroke:var(--ls);stroke-width:0.6;stroke-linejoin:round}
.connector{stroke:#1a5c38;stroke-width:1;stroke-dasharray:3,3;fill:none;opacity:0.4}
.dot{fill:#1a5c38;opacity:0.3}
.pin{cursor:pointer}
.pin circle{transition:r 0.15s}
.pin:hover circle{r:14!important}
.pin.active circle{stroke:var(--ac)!important;stroke-width:3!important;r:14!important}
.sidebar{background:white;border-left:1px solid #d8e8df;display:flex;flex-direction:column;overflow:hidden}
.sbh{padding:14px 18px 10px;border-bottom:1px solid #edf2ef;background:var(--gp);flex-shrink:0}
.sbh h2{font-family:'Playfair Display',serif;font-size:1rem;color:var(--gd);margin-bottom:2px}
.sbh p{font-size:0.72rem;color:var(--tl)}
.list{overflow-y:auto;flex:1}
.row{display:flex;align-items:flex-start;gap:10px;padding:9px 15px;cursor:pointer;border-left:3px solid transparent;border-bottom:1px solid #f0f5f2;transition:background 0.1s,border-color 0.1s}
.row:hover{background:var(--gp)}
.row.active{background:var(--gl);border-left-color:var(--gd)}
.rdot{width:9px;height:9px;border-radius:50%;background:var(--gd);flex-shrink:0;margin-top:5px}
.row.active .rdot{background:var(--ac)}
.rt{flex:1;min-width:0}
.rloc{font-size:0.67rem;font-weight:600;color:var(--tl);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:1px}
.rart{font-size:0.88rem;font-weight:600;color:var(--td);line-height:1.25}
.rgen{font-size:0.71rem;color:var(--tl);margin-top:1px;font-style:italic}
.panel{
  position:absolute;bottom:16px;left:16px;background:white;border-radius:10px;
  box-shadow:0 4px 24px rgba(0,0,0,0.2);width:340px;
  border-left:5px solid var(--gd);opacity:0;transform:translateY(12px);
  transition:opacity 0.2s,transform 0.2s;pointer-events:none;z-index:10;overflow:hidden;
}
.panel.on{opacity:1;transform:translateY(0);pointer-events:auto}
.panel-top{padding:15px 18px 11px;position:relative}
.pn{font-size:0.67rem;font-weight:600;color:var(--gm);text-transform:uppercase;letter-spacing:1px;margin-bottom:2px}
.ploc{font-family:'Playfair Display',serif;font-size:1.1rem;color:var(--gd);font-weight:700;margin-bottom:3px}
.pgen{display:inline-block;background:var(--gl);color:var(--gd);font-size:0.71rem;font-weight:600;padding:2px 10px;border-radius:20px;margin-bottom:8px}
.pnote{font-size:0.80rem;color:var(--tm);line-height:1.5;border-top:1px solid #edf2ef;padding-top:8px}
.vid-btn{display:block;width:100%;position:relative;background:#000;cursor:pointer;border:none;padding:0;border-top:1px solid #edf2ef;text-decoration:none}
.vid-thumb{width:100%;aspect-ratio:16/9;object-fit:cover;display:block;opacity:0.85;transition:opacity 0.15s}
.vid-btn:hover .vid-thumb{opacity:1}
.vid-play{
  position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
  width:52px;height:52px;border-radius:50%;background:rgba(255,0,0,0.88);
  display:flex;align-items:center;justify-content:center;
  transition:transform 0.15s,background 0.15s;pointer-events:none;
}
.vid-btn:hover .vid-play{background:rgb(255,0,0);transform:translate(-50%,-50%) scale(1.08)}
.vid-play svg{width:20px;height:20px;fill:white;margin-left:3px}
.vid-label{font-size:0.7rem;color:var(--tl);padding:5px 18px 9px;background:#f9fbfa}
.vid-label strong{color:var(--gd)}
.cls{position:absolute;top:8px;right:10px;background:none;border:none;font-size:1.1rem;color:var(--tl);cursor:pointer;padding:2px 4px;line-height:1}
.cls:hover{color:var(--td)}
</style>
</head>
<body>
<header>
